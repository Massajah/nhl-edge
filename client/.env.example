# Public values compiled into the browser bundle. None of these are secrets.
VITE_GOOGLE_CLIENT_ID=
# Optional production error monitoring. Leave VITE_SENTRY_DSN empty to disable Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Optional explicit override. Vercel builds otherwise use VERCEL_GIT_COMMIT_SHA.
VITE_SENTRY_RELEASE=
# Leave empty in development so Vite proxies /api to http://localhost:5000.
# Production: https://nhl-edge-production.up.railway.app
VITE_API_BASE_URL=

# Optional local/transitional UI only. The server must separately enable local auth.
VITE_LOCAL_AUTH_ENABLED=false
